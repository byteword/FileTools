<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputName>FileToolsSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion>1.1.0.0</ProductVersion>
    <MsiPath>$(MSBuildThisFileDirectory)..\FileTools.Installer\bin\$(Configuration)\FileTools.msi</MsiPath>
    <AppIconPath>$(MSBuildThisFileDirectory)..\..\src\FileTools.App\Resources\FileToolsIcon.ico</AppIconPath>
    <SetupLogoPath>$(MSBuildThisFileDirectory)Assets\FileToolsSetupLogo.png</SetupLogoPath>
    <BundleThemePath>$(MSBuildThisFileDirectory)Assets\FileToolsTheme.xml</BundleThemePath>
    <BundleThemeLocalizationPath>$(MSBuildThisFileDirectory)Assets\FileToolsTheme.wxl</BundleThemeLocalizationPath>
    <IdentityHelperPath>$(MSBuildThisFileDirectory)..\..\artifacts\publish\FileTools.IdentityHelper-win-x64\FileTools.IdentityHelper.exe</IdentityHelperPath>
    <IdentityMsixPath>$(MSBuildThisFileDirectory)..\..\artifacts\identity\FileTools.Identity.msix</IdentityMsixPath>
    <IdentityCertificatePath>$(MSBuildThisFileDirectory)..\..\artifacts\identity\FileTools.Identity.cer</IdentityCertificatePath>
    <DefineConstants>ProductVersion=$(ProductVersion);MsiPath=$(MsiPath);AppIconPath=$(AppIconPath);SetupLogoPath=$(SetupLogoPath);BundleThemePath=$(BundleThemePath);BundleThemeLocalizationPath=$(BundleThemeLocalizationPath);IdentityHelperPath=$(IdentityHelperPath);IdentityMsixPath=$(IdentityMsixPath);IdentityCertificatePath=$(IdentityCertificatePath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>

  <Target Name="BuildFileToolsMsi" BeforeTargets="CoreCompile" Condition="'$(SkipBuildFileToolsMsi)' != 'true'">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\FileTools.Installer\FileTools.Installer.wixproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
