<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputName>FileToolsSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <FileToolsVersion Condition="'$(FileToolsVersion)' == ''">1.4.5.1</FileToolsVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(FileToolsVersion)</ProductVersion>
    <MsiPath>$(MSBuildThisFileDirectory)..\FileTools.Installer\bin\$(Configuration)\FileTools.msi</MsiPath>
    <AppIconPath>$(MSBuildThisFileDirectory)..\..\src\FileTools.App\Resources\FileToolsIcon.ico</AppIconPath>
    <SetupLogoPath>$(MSBuildThisFileDirectory)Assets\FileToolsSetupLogo.png</SetupLogoPath>
    <BundleThemePath>$(MSBuildThisFileDirectory)Assets\FileToolsTheme.xml</BundleThemePath>
    <BundleThemeLocalizationPath>$(MSBuildThisFileDirectory)Assets\FileToolsTheme.wxl</BundleThemeLocalizationPath>
    <DefineConstants>ProductVersion=$(ProductVersion);MsiPath=$(MsiPath);AppIconPath=$(AppIconPath);SetupLogoPath=$(SetupLogoPath);BundleThemePath=$(BundleThemePath);BundleThemeLocalizationPath=$(BundleThemeLocalizationPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>

  <Target Name="BuildFileToolsMsi" BeforeTargets="CoreCompile" Condition="'$(SkipBuildFileToolsMsi)' != 'true'">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\FileTools.Installer\FileTools.Installer.wixproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);FileToolsVersion=$(ProductVersion);ProductVersion=$(ProductVersion)" />
  </Target>
</Project>
