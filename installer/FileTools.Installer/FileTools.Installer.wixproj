<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputName>FileTools</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <FileToolsVersion Condition="'$(FileToolsVersion)' == ''">1.4.5.1</FileToolsVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(FileToolsVersion)</ProductVersion>
    <SuppressIces>ICE91</SuppressIces>
    <AppPublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\publish\FileTools-win-x64\</AppPublishDir>
    <AppIconPath>$(MSBuildThisFileDirectory)..\..\src\FileTools.App\Resources\FileToolsIcon.ico</AppIconPath>
    <ShellExtensionPath>$(MSBuildThisFileDirectory)..\..\src\FileTools.ShellExt\x64\Release\FileTools.ShellExt.dll</ShellExtensionPath>
    <IdentityMsixPath>$(MSBuildThisFileDirectory)..\..\artifacts\identity\FileTools.Identity.msix</IdentityMsixPath>
    <IdentityCertificatePath>$(MSBuildThisFileDirectory)..\..\artifacts\identity\FileTools.Identity.cer</IdentityCertificatePath>
    <LicenseRtfPath>$(MSBuildThisFileDirectory)License.rtf</LicenseRtfPath>
    <MsiDialogBmpPath>$(MSBuildThisFileDirectory)Assets\FileToolsDialogBmp.png</MsiDialogBmpPath>
    <MsiBannerBmpPath>$(MSBuildThisFileDirectory)Assets\FileToolsBannerBmp.png</MsiBannerBmpPath>
    <DefineConstants>AppPublishDir=$(AppPublishDir);ProductVersion=$(ProductVersion);AppIconPath=$(AppIconPath);ShellExtensionPath=$(ShellExtensionPath);IdentityMsixPath=$(IdentityMsixPath);IdentityCertificatePath=$(IdentityCertificatePath);LicenseRtfPath=$(LicenseRtfPath);MsiDialogBmpPath=$(MsiDialogBmpPath);MsiBannerBmpPath=$(MsiBannerBmpPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
  </ItemGroup>

  <Target Name="CleanFileToolsAppPublishDir" BeforeTargets="PublishFileToolsApp">
    <RemoveDir Directories="$(AppPublishDir)" />
  </Target>

  <Target Name="PublishFileToolsApp" BeforeTargets="CoreCompile">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\..\src\FileTools.App\FileTools.App.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=true;PublishDir=$(AppPublishDir);FileToolsVersion=$(ProductVersion)" />
  </Target>
</Project>
