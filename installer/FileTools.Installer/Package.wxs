        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileTools\shell\FileTools_07_AutoRelocationChooseTarget\command" Type="string" Value="&quot;[INSTALLFOLDER]FileTools.exe&quot; /context AutoRelocationChooseTarget &quot;%1&quot;" />
