    <DirectoryRef Id="ProgramMenuFileTools">
      <Component Id="StartMenuShortcutComponent" Guid="4cbe5d9c-11be-4bf8-ae44-d6ec6ffad7e3">
        <Shortcut
          Id="StartMenuShortcut"
          Name="FileTools"
          Target="[INSTALLFOLDER]FileTools.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramMenuFileTools" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\FileTools"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="AppFeature" Title="FileTools" Description="FileTools application and Start Menu shortcut." Level="1">
      <ComponentRef Id="FileToolsExeComponent" />
      <ComponentRef Id="InstallStateComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />

      <Feature Id="ContextMenuFeature" Title="Explorer Context Menu" Description="Register FileTools commands in Explorer context menus." Level="1">
        <Feature Id="ContextMenuGroupedFeature" Title="Grouped Context Menu" Description="Show one FileTools menu with subcommands. This is the default." Level="1">
          <ComponentRef Id="ContextMenuGroupedFilesComponent" />
          <ComponentRef Id="ContextMenuGroupedDirectoriesComponent" />
        </Feature>
        <Feature Id="ContextMenuExpandedFeature" Title="Expanded Context Menu" Description="Show FileTools commands directly in the context menu." Level="2">
          <ComponentRef Id="ContextMenuExpandedFilesComponent" />
          <ComponentRef Id="ContextMenuExpandedDirectoriesComponent" />
        </Feature>
      </Feature>
    </Feature>
  </Package>
</Wix>
