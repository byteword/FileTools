        <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\FileTools\shell\FileTools_99_Open\command" Type="string" Value="&quot;[INSTALLFOLDER]FileTools.exe&quot; /open &quot;%1&quot;" />
