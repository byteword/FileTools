<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FileTools.Correction.SymSpellPlugin</AssemblyName>
    <RootNamespace>FileTools.Correction.SymSpellPlugin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileTools.Correction.Abstractions\FileTools.Correction.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SymSpell" Version="6.7.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
