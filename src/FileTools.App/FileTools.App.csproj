<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FileTools</AssemblyName>
    <RootNamespace>FileTools</RootNamespace>
    <Version>1.2.0.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\FileToolsIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Ui\MainForm.*.resx" />
    <Compile Update="Ui\MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\AutoRelocationTemplateEditorDialog.Designer.cs">
      <DependentUpon>AutoRelocationTemplateEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\FileKindClassificationEditorDialog.Designer.cs">
      <DependentUpon>FileKindClassificationEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\NameTemplateSettingsDialog.Designer.cs">
      <DependentUpon>NameTemplateSettingsDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\PlanStepDialog.Designer.cs">
      <DependentUpon>PlanStepDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\RenameDictionaryEditorDialog.Designer.cs">
      <DependentUpon>RenameDictionaryEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\RenameReviewDialog.Designer.cs">
      <DependentUpon>RenameReviewDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\RenameRuleEditorDialog.Designer.cs">
      <DependentUpon>RenameRuleEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\SettingsForm.Designer.cs">
      <DependentUpon>SettingsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\StringListEditorDialog.Designer.cs">
      <DependentUpon>StringListEditorDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Strings.ko.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Ui\MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
