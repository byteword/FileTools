<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FileTools</AssemblyName>
    <RootNamespace>FileTools</RootNamespace>
    <FileToolsVersion Condition="'$(FileToolsVersion)' == ''">1.4.4.2</FileToolsVersion>
    <Version>$(FileToolsVersion)</Version>
    <AssemblyVersion>$(FileToolsVersion)</AssemblyVersion>
    <FileVersion>$(FileToolsVersion)</FileVersion>
    <InformationalVersion>$(FileToolsVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <FileToolsManifestTemplate>$(MSBuildProjectDirectory)\app.manifest</FileToolsManifestTemplate>
    <FileToolsGeneratedManifest>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\FileTools.app.manifest</FileToolsGeneratedManifest>
    <ApplicationManifest>$(FileToolsGeneratedManifest)</ApplicationManifest>
    <ApplicationIcon>Resources\FileToolsIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Ui\MainForm.*.resx" />
    <EmbeddedResource Include="..\..\LICENSE" Link="LICENSE.txt" LogicalName="FileTools.LICENSE.txt" />
    <EmbeddedResource Include="Resources\FileToolsIcon.ico" LogicalName="FileTools.Resources.FileToolsIcon.ico" />
    <Compile Update="Ui\MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\AutoRelocationTemplateEditorDialog.Designer.cs">
      <DependentUpon>AutoRelocationTemplateEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\FileKindClassificationEditorDialog.Designer.cs">
      <DependentUpon>FileKindClassificationEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\NameTemplateSettingsDialog.Designer.cs">
      <DependentUpon>NameTemplateSettingsDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\PlanStepDialog.Designer.cs">
      <DependentUpon>PlanStepDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\RenameDictionaryEditorDialog.Designer.cs">
      <DependentUpon>RenameDictionaryEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\RenameReviewDialog.Designer.cs">
      <DependentUpon>RenameReviewDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\RenameRuleEditorDialog.Designer.cs">
      <DependentUpon>RenameRuleEditorDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\SettingsForm.Designer.cs">
      <DependentUpon>SettingsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Ui\StringListEditorDialog.Designer.cs">
      <DependentUpon>StringListEditorDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Strings.ko.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Ui\MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileTools.Correction.Abstractions\FileTools.Correction.Abstractions.csproj" />
    <ProjectReference Include="..\FileTools.Correction.SymSpellPlugin\FileTools.Correction.SymSpellPlugin.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <Target Name="GenerateFileToolsApplicationManifest" BeforeTargets="GenerateApplicationManifest;CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <PropertyGroup>
      <FileToolsApplicationManifestText>$([System.IO.File]::ReadAllText('$(FileToolsManifestTemplate)').Replace('__FILETOOLS_VERSION__', '$(FileToolsVersion)'))</FileToolsApplicationManifestText>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(ApplicationManifest)"
      Lines="$(FileToolsApplicationManifestText)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>
  <Target Name="CopyCorrectionPlugins" AfterTargets="Build">
    <ItemGroup>
      <SymSpellPluginFiles Include="..\FileTools.Correction.SymSpellPlugin\bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(SymSpellPluginFiles)"
      DestinationFiles="@(SymSpellPluginFiles->'$(OutputPath)Plugins\FileTools.Correction.SymSpellPlugin\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
